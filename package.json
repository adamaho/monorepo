{
  "name": "monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "check": "pnpm fmt:check && pnpm lint && turbo run tsc",
    "clean": "turbo run clean && rimraf node_modules",
    "dev": "turbo run dev --ui=tui",
    "lint": "oxlint .",
    "fmt": "oxfmt --config ./tools/oxfmt-config/src/base.json .",
    "fmt:check": "oxfmt --check --config ./tools/oxfmt-config/src/base.json .",
    "tsc": "turbo run tsc",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@adamaho/nopeus-oxlint-config": "catalog:",
    "@adamaho/nopeus-oxlint-plugin": "catalog:",
    "@changesets/cli": "catalog:",
    "@monorepo/tool-oxfmt-config": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:"
  },
  "engines": {
    "node": "^24.15.0",
    "pnpm": "^11.21.0"
  },
  "packageManager": "pnpm@11.21.0"
}
