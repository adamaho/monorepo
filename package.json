{
  "name": "monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "check": "pnpm fmt:check && pnpm lint && turbo run tsc",
    "clean": "turbo run clean && rimraf node_modules",
    "dev": "turbo run dev --ui=tui",
    "lint": "oxlint .",
    "fmt": "oxfmt --config ./tools/oxfmt-config/src/base.json .",
    "fmt:check": "oxfmt --check --config ./tools/oxfmt-config/src/base.json .",
    "tsc": "turbo run tsc",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@adamaho/nopeus-oxlint-config": "catalog:",
    "@adamaho/nopeus-oxlint-plugin": "catalog:",
    "@changesets/cli": "catalog:",
    "@effect/vitest": "catalog:",
    "@monorepo/tool-oxfmt-config": "workspace:*",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "turbo": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.15.0",
    "pnpm": "^12.3.4"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
